
#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int u, v, w;
};

bool compare(Edge a, Edge b) {
    return a.w < b.w;
}

int parent[100];

int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}

void unite(int a, int b) {
    parent[find(a)] = find(b);
}

int main() {
    int n, m;
    Edge e[100];

    cout << "Enter number of vertices and edges: ";
    cin >> n >> m;

    cout << "Enter edges (u v weight):\n";
    for (int i = 0; i < m; i++) {
        cin >> e[i].u >> e[i].v >> e[i].w;
    }

    for (int i = 0; i < n; i++)
        parent[i] = i;

    sort(e, e + m, compare);

    int cost = 0, count = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    for (int i = 0; i < m && count < n - 1; i++) {
        int u = e[i].u;
        int v = e[i].v;
        int w = e[i].w;

        if (find(u) != find(v)) {
            cout << u << " - " << v
                 << " : " << w << endl;

            unite(u, v);
            cost += w;
            count++;
        }
    }

    if (count != n - 1) {
        cout << "Graph is disconnected.\n";
    } else {
        cout << "Minimum cost = " << cost << endl;
    }

    return 0;
}
